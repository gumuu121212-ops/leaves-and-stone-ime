arm64x_wrapper/*.ime
arm64x_wrapper/*.lib
arm64x_wrapper/*.exp

# Third-party payload the installer ships. Upstream Weasel commits these, so the
# /output/*.exe, /output/*.bat and /output/*.txt rules above must not hide them:
# without them makensis aborts on install.nsi ("File: file not found").
!/output/7z.exe
!/output/curl.exe
!/output/7-zip-license.txt
!/output/COPYING-curl.txt
!/output/install.bat
!/output/uninstall.bat
!/output/rime-install.bat
!/output/rime-install-config.bat
!/output/start_service.bat
!/output/stop_service.bat
!/output/archives/
!/output/archives/.placeholder


